                    <button
                      onClick={() => fileInputRef.current?.click()}
                      className="px-2 py-1 rounded text-[11px] bg-[#121212] border border-[#2e2e2e] text-[#ffcc66] hover:border-[#ffcc66] flex items-center gap-1 cursor-pointer"
                    >
                      <Upload className="w-3 h-3" />
                      Load File
                    </button>
                    <input
                      ref={fileInputRef}
                      type="file"
                      accept="video/mp4,video/webm,video/quicktime,video/*"
                      onChange={handleFileUpload}
                      className="hidden"
                    />
                  </div>
                </div>

                {/* Player Viewport */}
                <div className="relative bg-[#0a0a0a] aspect-video w-full overflow-hidden flex items-center justify-center">
                  {playerSourceType === 'local_file' && localVideoUrl ? (
                    <video
                      ref={playerVideoRef}
                      src={localVideoUrl}
                      autoPlay
                      loop
                      onTimeUpdate={(e) => {
                        const vid = e.currentTarget;
                        setPlayerTime(vid.currentTime);
                        if (
                          loopA !== null &&
                          loopB !== null &&
                          loopB > loopA &&
                          vid.currentTime >= loopB
                        ) {
                          vid.currentTime = loopA;
                        }
                      }}
                      onLoadedMetadata={(e) => {
                        setPlayerDuration(e.currentTarget.duration || 60);
                      }}
                      className="w-full h-full object-contain bg-black"
                    />
                  ) : (
                    <canvas
                      ref={playerCanvasRef}
                      width={960}
                      height={540}
                      className="w-full h-full object-cover"
                    />
                  )}

                  {/* Player Telemetry HUD */}
                  <div className="absolute bottom-2 left-2.5 right-2.5 flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono bg-[#121212]/90 border border-[#2e2e2e] px-2.5 py-1 rounded">
                    <span className="text-[#00adb5]">
                      {playerSourceType === 'local_file'
                        ? `FILE: ${localFileName}`
                        : `${playerTelemetry.codec} • ${playerTelemetry.bitrateMbps} Mbps`}
                    </span>
                    <span className="text-[#00e676]">
                      BUF: {dsnOptions.find((o) => o.key === 'buffer_ms')?.value || 120}ms • DROP:{' '}
                      {playerTelemetry.droppedFrames}
                    </span>
                  </div>
                </div>

                {/* Frame-Accurate Transport & Jog/Shuttle Controls */}
                <div className="p-3 bg-[#1a1a1a] border-t border-[#2e2e2e] flex flex-col gap-3">
                  {/* Scrubber Bar with A/B Loop Markers */}
                  <div className="flex flex-col gap-1">
                    <div className="relative flex items-center">
                      <input
                        type="range"
                        min={0}
                        max={playerDuration || 100}
                        step={0.033}
                        value={playerTime}
                        onChange={(e) => {
                          const val = Number(e.target.value);
                          setPlayerTime(val);
                          if (playerSourceType === 'local_file' && playerVideoRef.current) {
                            playerVideoRef.current.currentTime = val;
                          }
                        }}
                        className="w-full accent-[#00adb5] h-1.5 bg-[#121212] rounded cursor-pointer"
                      />
                    </div>
                    <div className="flex justify-between text-[10px] font-mono text-[#9e9e9e]">
                      <span>POS: {formatTimecode(playerTime * 30, 30)}</span>
                      <span>
                        {loopA !== null ? `IN: ${loopA.toFixed(1)}s` : 'IN: --'}{' '}
                        {loopB !== null ? `| OUT: ${loopB.toFixed(1)}s` : '| OUT: --'}
                      </span>
                      <span>DUR: {formatTimecode(playerDuration * 30, 30)}</span>
                    </div>
                  </div>

                  {/* Transport Buttons & Speed Selector */}
                  <div className="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-[#2e2e2e]">
                    <div className="flex items-center gap-1.5">
                      <button
                        onClick={() => handleStepFrame(-1)}
                        title="Step Backward (-1 Frame)"
                        className="px-2 py-1.5 rounded bg-[#121212] border border-[#2e2e2e] text-white hover:border-[#00adb5] flex items-center gap-1 text-[11px] font-mono cursor-pointer"
                      >
                        <SkipBack className="w-3.5 h-3.5 text-[#00adb5]" />
                        -1f
                      </button>

                      <button
                        onClick={togglePlayPause}
                        className="px-3 py-1.5 rounded bg-[#00adb5] text-[#121212] font-bold text-xs flex items-center gap-1 cursor-pointer"
                      >
                        {isPlaying ? (
                          <>
                            <Pause className="w-3.5 h-3.5 fill-current" />
                            PAUSE
                          </>
                        ) : (
                          <>
                            <Play className="w-3.5 h-3.5 fill-current" />
                            PLAY
                          </>
                        )}
                      </button>

                      <button
                        onClick={() => handleStepFrame(1)}
                        title="Step Forward (+1 Frame)"
                        className="px-2 py-1.5 rounded bg-[#121212] border border-[#2e2e2e] text-white hover:border-[#00adb5] flex items-center gap-1 text-[11px] font-mono cursor-pointer"
                      >
                        +1f
                        <SkipForward className="w-3.5 h-3.5 text-[#00adb5]" />
                      </button>
                    </div>

                    {/* A/B Loop Markers */}
                    <div className="flex items-center gap-1">
                      <button
                        onClick={() => setLoopA(playerTime)}
                        className={`px-2 py-1 rounded text-[11px] font-mono border cursor-pointer ${
                          loopA !== null
                            ? 'bg-[#ffcc66]/20 border-[#ffcc66] text-[#ffcc66]'
                            : 'bg-[#121212] border-[#2e2e2e] text-[#b0b0b0]'
                        }`}
                      >
                        Mark A
                      </button>
                      <button
                        onClick={() => setLoopB(playerTime)}
                        className={`px-2 py-1 rounded text-[11px] font-mono border cursor-pointer ${
                          loopB !== null
                            ? 'bg-[#ffcc66]/20 border-[#ffcc66] text-[#ffcc66]'
                            : 'bg-[#121212] border-[#2e2e2e] text-[#b0b0b0]'
                        }`}
                      >
                        Mark B
                      </button>
                      {(loopA !== null || loopB !== null) && (
                        <button
                          onClick={() => {
                            setLoopA(null);
                            setLoopB(null);
                          }}
                          className="px-1.5 py-1 rounded text-[10px] font-mono bg-[#121212] border border-[#2e2e2e] text-[#9e9e9e] hover:text-white cursor-pointer"
                        >
                          Clear
                        </button>
                      )}
                    </div>

                    {/* Jog / Shuttle Speed Pills */}
                    <div className="flex items-center gap-1 bg-[#121212] p-0.5 rounded border border-[#2e2e2e]">
                      {[0.25, 0.5, 1, 1.5, 2].map((rate) => (
                        <button
                          key={rate}
                          onClick={() => handleSpeedChange(rate)}
                          className={`px-1.5 py-0.5 rounded text-[10px] font-mono cursor-pointer ${
                            playbackRate === rate
                              ? 'bg-[#00adb5] text-[#121212] font-bold'
                              : 'text-[#9e9e9e] hover:text-white'
                          }`}
                        >
                          {rate}x
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              </section>
            )}
          </div>

          {/* LIVE COMPUTED DSN URI & SHA-256 INTEGRITY BAR */}
          <section className="bg-[#1e1e1e] border border-[#2e2e2e] rounded-lg p-3.5 flex flex-col gap-2.5">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <div className="flex items-center gap-2">
                <ShieldCheck className="w-4 h-4 text-[#00e676]" />
                <span className="text-xs font-bold uppercase tracking-wider text-white">
                  Live DSN Connection String & Canonical SHA-256 Digest
                </span>
              </div>
              <span className="text-[11px] font-mono text-[#00e676] bg-[#00e676]/10 border border-[#00e676]/30 px-2 py-0.5 rounded">
                WEB CRYPTO SHA-256 VERIFIED
              </span>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-2 gap-2.5">
              {/* Computed DSN URI */}
              <div className="bg-[#121212] border border-[#2e2e2e] rounded p-2.5 flex items-center justify-between gap-2">
                <div className="overflow-hidden">
                  <div className="text-[10px] font-mono text-[#9e9e9e] uppercase">
                    Computed DSN URI
                  </div>
                  <div className="font-mono text-xs text-[#00adb5] truncate">{computedDsnUri}</div>
                </div>
                <button
                  onClick={() => copyToClipboard(computedDsnUri, 'dsn')}
                  className="p-1.5 rounded bg-[#1e1e1e] border border-[#2e2e2e] text-[#b0b0b0] hover:text-white shrink-0 cursor-pointer"
                  title="Copy DSN URI"
                >
                  {copiedKey === 'dsn' ? (
                    <Check className="w-3.5 h-3.5 text-[#00e676]" />
                  ) : (
                    <Copy className="w-3.5 h-3.5" />
                  )}
                </button>
              </div>

              {/* SHA-256 Digest */}
              <div className="bg-[#121212] border border-[#2e2e2e] rounded p-2.5 flex items-center justify-between gap-2">
                <div className="overflow-hidden">
                  <div className="text-[10px] font-mono text-[#9e9e9e] uppercase">
                    Canonical Config SHA-256
                  </div>
                  <div className="font-mono text-xs text-[#00e676] truncate">{sha256Digest}</div>
                </div>
                <button
                  onClick={() => copyToClipboard(sha256Digest, 'sha')}
                  className="p-1.5 rounded bg-[#1e1e1e] border border-[#2e2e2e] text-[#b0b0b0] hover:text-white shrink-0 cursor-pointer"
                  title="Copy SHA-256 Hash"
                >
                  {copiedKey === 'sha' ? (
                    <Check className="w-3.5 h-3.5 text-[#00e676]" />
                  ) : (
                    <Copy className="w-3.5 h-3.5" />
                  )}
                </button>
              </div>
            </div>
          </section>
        </div>

        {/* RIGHT SIDEBAR: HOT-RELOADABLE ENDPOINT & DSN CONFIGURATOR (4 cols on xl) */}
        <aside className="xl:col-span-4 bg-[#1e1e1e] border border-[#2e2e2e] rounded-lg p-4 flex flex-col gap-4">
          <div className="flex items-center justify-between border-b border-[#2e2e2e] pb-3">
            <div className="flex items-center gap-2">
              <Network className="w-4 h-4 text-[#00adb5]" />
              <h2 className="text-xs font-bold uppercase tracking-wider text-white">
                Endpoint & DSN Configurator
              </h2>
            </div>

            <div className="flex items-center gap-1.5">
              <span
                className={`w-2 h-2 rounded-full ${
                  connStatus === 'CONNECTED'
                    ? 'bg-[#00e676]'
                    : 'bg-[#ffcc66] animate-ping'
                }`}
              />
              <span
                className={`text-[10px] font-mono font-bold ${
                  connStatus === 'CONNECTED' ? 'text-[#00e676]' : 'text-[#ffcc66]'
                }`}
              >
                {connStatus === 'RECONNECTING'
                  ? `BACKOFF #${backoffAttempt} (${currentBackoffMs}ms)`
                  : 'LINK READY'}
              </span>
            </div>
          </div>

          {/* Sync IP Toggle & Backoff Test Button */}
          <div className="flex flex-wrap items-center justify-between gap-2 bg-[#121212] p-2.5 rounded border border-[#2e2e2e]">
            <label className="flex items-center gap-2 text-xs text-[#d0d0d0] cursor-pointer">
              <input
                type="checkbox"
                checked={syncIpEnabled}
                onChange={(e) => setSyncIpEnabled(e.target.checked)}
                className="accent-[#00e676] rounded cursor-pointer"
              />
              <span>Sync IP to URL & DSN</span>
            </label>

            <button
              onClick={triggerBackoffReconnectTest}
              className="px-2.5 py-1 rounded text-[11px] font-mono bg-[#1e1e1e] border border-[#2e2e2e] text-[#ffcc66] hover:border-[#ffcc66] flex items-center gap-1.5 cursor-pointer"
            >
              <RefreshCw
                className={`w-3 h-3 ${connStatus === 'RECONNECTING' ? 'animate-spin' : ''}`}
              />
              Test Backoff
            </button>
          </div>

          {/* Target IP & Port */}
          <div className="grid grid-cols-3 gap-2.5">
            <div className="col-span-2">
              <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                Target IP Address
              </label>
              <input
                type="text"
                value={ipAddress}
                onChange={(e) => handleIpChange(e.target.value)}
                placeholder="192.168.4.1"
                className="w-full bg-[#121212] border border-[#2e2e2e] focus:border-[#00adb5] outline-none rounded px-2.5 py-1.5 font-mono text-xs text-white"
              />
            </div>
            <div>
              <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                Port
              </label>
              <input
                type="number"
                value={port}
                onChange={(e) => handlePortChange(e.target.value)}
                className="w-full bg-[#121212] border border-[#2e2e2e] focus:border-[#00adb5] outline-none rounded px-2.5 py-1.5 font-mono text-xs text-white"
              />
            </div>
          </div>

          {/* Full Endpoint / Stream URL */}
          <div>
            <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
              Endpoint / Stream URL
            </label>
            <input
              type="text"
              value={endpointUrl}
              onChange={(e) => setEndpointUrl(e.target.value)}
              className="w-full bg-[#121212] border border-[#2e2e2e] focus:border-[#00adb5] outline-none rounded px-2.5 py-1.5 font-mono text-xs text-[#00e676]"
            />
          </div>

          {/* DSN Driver, Host, Port, Database */}
          <div className="border-t border-[#2e2e2e] pt-3 flex flex-col gap-2.5">
            <div className="flex items-center gap-1.5 text-xs font-bold text-[#e0e0e0]">
              <Sliders className="w-3.5 h-3.5 text-[#ffcc66]" />
              <span>DSN Transport & Database Parameters</span>
            </div>

            <div className="grid grid-cols-2 gap-2.5">
              <div>
                <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                  DSN Driver
                </label>
                <select
                  value={dsnDriver}
                  onChange={(e) => setDsnDriver(e.target.value)}
                  className="w-full bg-[#121212] border border-[#2e2e2e] rounded px-2.5 py-1.5 font-mono text-xs text-white"
                >
                  <option value="rtsp">rtsp</option>
                  <option value="srt">srt</option>
                  <option value="webrtc">webrtc</option>
                  <option value="hls">hls</option>
                  <option value="postgresql">postgresql</option>
                  <option value="sqlite">sqlite</option>
                </select>
              </div>

              <div>
                <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                  Endpoint / DB Path
                </label>
                <input
                  type="text"
                  value={dsnDatabase}
                  onChange={(e) => setDsnDatabase(e.target.value)}
                  className="w-full bg-[#121212] border border-[#2e2e2e] rounded px-2.5 py-1.5 font-mono text-xs text-white"
                />
              </div>
            </div>

            <div className="grid grid-cols-3 gap-2">
              <div>
                <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                  DSN User
                </label>
                <input
                  type="text"
                  value={dsnUser}
                  onChange={(e) => setDsnUser(e.target.value)}
                  className="w-full bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1.5 font-mono text-xs text-white"
                />
              </div>
              <div>
                <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                  DSN Host
                </label>
                <input
                  type="text"
                  value={dsnHost}
                  onChange={(e) => setDsnHost(e.target.value)}
                  className="w-full bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1.5 font-mono text-xs text-white"
                />
              </div>
              <div>
                <label className="block text-[10px] font-mono uppercase text-[#9e9e9e] mb-1">
                  DSN Port
                </label>
                <input
                  type="number"
                  value={dsnPort}
                  onChange={(e) => setDsnPort(Number(e.target.value))}
                  className="w-full bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1.5 font-mono text-xs text-white"
                />
              </div>
            </div>
          </div>

          {/* Dynamic Key-Value DSN Options Editor */}
          <div className="border-t border-[#2e2e2e] pt-3 flex flex-col gap-2">
            <div className="flex items-center justify-between">
              <span className="text-[10px] font-mono uppercase text-[#9e9e9e]">
                DSN Query / Connection Options ({dsnOptions.length})
              </span>
              <Wifi className="w-3.5 h-3.5 text-[#00adb5]" />
            </div>

            <div className="flex flex-col gap-1.5 max-h-[210px] overflow-y-auto pr-1">
              {dsnOptions.map((opt) => (
                <div key={opt.id} className="flex items-center gap-1.5">
                  <input
                    type="text"
                    value={opt.key}
                    onChange={(e) => handleOptionEdit(opt.id, 'key', e.target.value)}
                    placeholder="key"
                    className="w-1/2 bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1 font-mono text-[11px] text-[#ffcc66]"
                  />
                  <input
                    type="text"
                    value={opt.value}
                    onChange={(e) => handleOptionEdit(opt.id, 'value', e.target.value)}
                    placeholder="value"
                    className="w-1/2 bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1 font-mono text-[11px] text-[#00e676]"
                  />
                  <button
                    onClick={() => handleRemoveOption(opt.id)}
                    className="p-1 text-[#8e8e8e] hover:text-[#ff5252] cursor-pointer"
                    title="Remove Option"
                  >
                    <Trash2 className="w-3.5 h-3.5" />
                  </button>
                </div>
              ))}
            </div>

            {/* Add New DSN Option Row */}
            <div className="flex items-center gap-1.5 pt-1">
              <input
                type="text"
                value={newOptKey}
                onChange={(e) => setNewOptKey(e.target.value)}
                placeholder="new_option_key"
                className="w-1/2 bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1 font-mono text-[11px] text-white"
              />
              <input
                type="text"
                value={newOptVal}
                onChange={(e) => setNewOptVal(e.target.value)}
                placeholder="value"
                className="w-1/2 bg-[#121212] border border-[#2e2e2e] rounded px-2 py-1 font-mono text-[11px] text-white"
              />
              <button
                onClick={handleAddOption}
                className="p-1.5 rounded bg-[#00adb5] text-[#121212] hover:bg-[#00c4cd] cursor-pointer"
                title="Add DSN Option"
              >
                <Plus className="w-3.5 h-3.5" />
              </button>
            </div>
          </div>
        </aside>
      </main>

      {/* 4. SESSION MANIFEST & SCHEMA.ORG JSON-LD DRAWER / MODAL */}
      {manifestDrawerOpen && (
        <div className="fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4">
          <div className="bg-[#1e1e1e] border border-[#2e2e2e] rounded-xl w-full max-w-3xl max-h-[88vh] flex flex-col overflow-hidden shadow-2xl">
            {/* Modal Header */}
            <div className="px-4 py-3 border-b border-[#2e2e2e] flex items-center justify-between bg-[#181818]">
              <div className="flex items-center gap-2">
                <Cpu className="w-4 h-4 text-[#00e676]" />
                <h3 className="text-sm font-bold text-white">
                  Schema.org JSON-LD & Integrity Manifest
                </h3>
              </div>
              <div className="flex items-center gap-2">
                <button
                  onClick={() =>
                    copyToClipboard(JSON.stringify(fullSessionManifest, null, 2), 'manifest')
                  }
                  className="px-2.5 py-1 rounded text-xs font-mono bg-[#121212] border border-[#2e2e2e] text-[#00adb5] hover:border-[#00adb5] flex items-center gap-1.5 cursor-pointer"
                >
                  {copiedKey === 'manifest' ? (
                    <>
                      <Check className="w-3.5 h-3.5 text-[#00e676]" />
                      Copied
                    </>
                  ) : (
                    <>
                      <Copy className="w-3.5 h-3.5" />
                      Copy JSON
                    </>
                  )}
                </button>
                <button
                  onClick={downloadManifestJson}
                  className="px-2.5 py-1 rounded text-xs font-mono font-bold bg-[#00e676] text-[#121212] flex items-center gap-1.5 cursor-pointer"
                >
                  <Download className="w-3.5 h-3.5" />
                  Download .json
                </button>
                <button
                  onClick={() => setManifestDrawerOpen(false)}
                  className="px-2.5 py-1 rounded text-xs bg-[#2a2a2a] text-white hover:bg-[#3a3a3a] cursor-pointer"
                >
                  Close
                </button>
              </div>
            </div>

            {/* JSON Payload Preview */}
            <div className="p-4 overflow-y-auto bg-[#121212] font-mono text-xs text-[#00e676] leading-relaxed">
              <pre>{JSON.stringify(fullSessionManifest, null, 2)}</pre>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
