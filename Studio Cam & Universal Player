          ctx.fillStyle = color;
          ctx.fillRect(idx * barW, barH, Math.ceil(barW), midH);
        });

        // Bottom Studio Gradient Ramp & Moving Sync Pulse
        const botY = barH + midH;
        const botH = h - botY;
        const grad = ctx.createLinearGradient(0, botY, w, botY);
        grad.addColorStop(0, '#050505');
        grad.addColorStop(0.5, '#7a7a7a');
        grad.addColorStop(1, '#f5f5f5');
        ctx.fillStyle = grad;
        ctx.fillRect(0, botY, w, botH);

        // Moving Genlock Sync Sweep Bar
        const sweepX = ((Math.sin(phase) + 1) / 2) * (w - 140) + 70;
        ctx.fillStyle = 'rgba(0, 230, 118, 0.85)';
        ctx.fillRect(sweepX - 3, 0, 6, h);

