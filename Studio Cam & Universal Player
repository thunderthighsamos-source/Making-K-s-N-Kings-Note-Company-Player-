        exposureCompensationEV: exposureComp,
        lutProfile: activeLutObj.name,
        timecode: formatTimecode(frameCount, 30)
      },
      networkConfiguration: canonicalConfigObject,
      computedDsnUri,
      integrityVerification: {
        algorithm: 'SHA-256',
        canonicalConfigDigest: sha256Digest,
        status: 'VERIFIED'
      }
    };
  }, [
