        }

        // Studio Dark Waveform / Horizon Viewport
        ctx.fillStyle = '#0b0e11';
        ctx.fillRect(0, 0, w, h);

        // Grid lines
        ctx.strokeStyle = '#1d242b';
        ctx.lineWidth = 1;
        for (let gx = 0; gx < w; gx += 48) {
          ctx.beginPath();
          ctx.moveTo(gx, 0);
          ctx.lineTo(gx, h);
          ctx.stroke();
        }
        for (let gy = 0; gy < h; gy += 48) {
          ctx.beginPath();
          ctx.moveTo(0, gy);
          ctx.lineTo(w, gy);
          ctx.stroke();
        }

        // Dual Oscilloscope / Vector Stream Waveforms
        ctx.strokeStyle = '#00adb5';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let x = 0; x < w; x += 4) {
          const y =
            h * 0.45 +
            Math.sin(x * 0.018 + t * 2.2) * 48 +
            Math.cos(x * 0.045 - t * 1.4) * 20;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        ctx.strokeStyle = '#00e676';
        ctx.lineWidth = 1.75;
        ctx.beginPath();
        for (let x = 0; x < w; x += 4) {
          const y =
            h * 0.58 +
            Math.cos(x * 0.022 + t * 1.8) * 34 +
            Math.sin(x * 0.06 + t * 3.1) * 14;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
