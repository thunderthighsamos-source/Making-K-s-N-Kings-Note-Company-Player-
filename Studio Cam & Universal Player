        ctx.fillRect(18, 18, 285, 56);
        ctx.strokeStyle = '#2e2e2e';
        ctx.strokeRect(18, 18, 285, 56);
        ctx.fillStyle = '#00e676';
        ctx.font = 'bold 12px monospace';
