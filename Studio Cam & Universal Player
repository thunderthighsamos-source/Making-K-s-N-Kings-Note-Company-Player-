        ctx.font = '11px monospace';
        ctx.fillText(`ISO ${isoValue} | ${shutterAngle}° | ${whiteBalance}K | EV ${exposureComp >= 0 ? '+' : ''}${exposureComp}`, 28, 58);
      }

