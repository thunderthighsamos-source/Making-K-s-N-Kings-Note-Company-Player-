  const handleRemoveOption = (id) => {
    setDsnOptions((prev) => prev.filter((item) => item.id !== id));
  };

  // Simulated Exponential-Backoff Reconnection Loop
  const triggerBackoffReconnectTest = () => {
    const baseOpt = dsnOptions.find((o) => o.key === 'reconnect_backoff_ms');
    const maxOpt = dsnOptions.find((o) => o.key === 'max_backoff_ms');
    const baseMs = Math.max(100, parseInt(baseOpt?.value || '500', 10) || 500);
    const maxMs = Math.max(baseMs, parseInt(maxOpt?.value || '15000', 10) || 15000);

    setConnStatus('RECONNECTING');
    setBackoffAttempt(1);
    setCurrentBackoffMs(baseMs);

    const step1 = setTimeout(() => {
      setBackoffAttempt(2);
      setCurrentBackoffMs(Math.min(maxMs, baseMs * 2));
    }, 550);

    const step2 = setTimeout(() => {
      setBackoffAttempt(3);
      setCurrentBackoffMs(Math.min(maxMs, baseMs * 4));
    }, 1150);

    const step3 = setTimeout(() => {
      setConnStatus('CONNECTED');
      setBackoffAttempt(0);
    }, 1800);

    return () => {
      clearTimeout(step1);
      clearTimeout(step2);
      clearTimeout(step3);
    };
  };

  // Computed DSN URI String
  const computedDsnUri = useMemo(() => {
    const queryPairs = dsnOptions
      .filter((o) => o.key.trim().length > 0)
      .map((o) => `${encodeURIComponent(o.key.trim())}=${encodeURIComponent(o.value)}`);
    const queryStr = queryPairs.length > 0 ? `?${queryPairs.join('&')}` : '';

    if (dsnDriver.toLowerCase() === 'sqlite') {
      return `sqlite:///${dsnDatabase.replace(/^\/+/, '')}${queryStr}`;
    }
    const auth = dsnUser.trim() ? `${encodeURIComponent(dsnUser.trim())}@` : '';
    const hostPort = dsnPort ? `${dsnHost}:${dsnPort}` : dsnHost;
    return `${dsnDriver}://${auth}${hostPort}/${dsnDatabase.replace(/^\/+/, '')}${queryStr}`;
  }, [dsnDriver, dsnUser, dsnHost, dsnPort, dsnDatabase, dsnOptions]);

  // Canonical Configuration Object for SHA-256 Digest
  const canonicalConfigObject = useMemo(() => {
    const optionsMap = {};
    dsnOptions.forEach((o) => {
      if (o.key.trim()) {
        optionsMap[o.key.trim()] = o.value;
      }
    });
    return {
      ip_address: ipAddress,
      port: Number(port),
      url: endpointUrl,
      dsn: {
        driver: dsnDriver,
        username: dsnUser,
        host: dsnHost,
        port: Number(dsnPort),
        database: dsnDatabase,
        options: optionsMap
      }
    };
  }, [ipAddress, port, endpointUrl, dsnDriver, dsnUser, dsnHost, dsnPort, dsnDatabase, dsnOptions]);

  // Update SHA-256 Digest whenever config changes
  useEffect(() => {
    let active = true;
    computeSha256Hex(canonicalConfigObject).then((hex) => {
      if (active) setSha256Digest(hex);
    });
    return () => {
      active = false;
    };
  }, [canonicalConfigObject]);

  // Schema.org JSON-LD + Integrity Manifest
