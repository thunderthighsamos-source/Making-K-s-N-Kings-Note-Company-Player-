    const renderSyntheticCamera = () => {
      const canvas = synthCanvasRef.current;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width;
        const h = canvas.height;
        phase += 0.04;

        // Background
        ctx.fillStyle = '#0d0d0d';
        ctx.fillRect(0, 0, w, h);

        // Top 68% SMPTE HD Color Bars
        const bars = [
          '#c0c0c0',
          '#c0c000',
          '#00c0c0',
          '#00c000',
          '#c000c0',
          '#c00000',
          '#0000c0'
        ];
        const barH = Math.floor(h * 0.66);
        const barW = w / bars.length;
        bars.forEach((color, idx) => {
          ctx.fillStyle = color;
          ctx.fillRect(idx * barW, 0, Math.ceil(barW), barH);
        });

        // Middle Castellations
        const midH = Math.floor(h * 0.08);
        const midColors = ['#0000c0', '#121212', '#c000c0', '#121212', '#00c0c0', '#121212', '#c0c0c0'];
