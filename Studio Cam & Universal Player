          ctx.strokeStyle = '#00e676';
          ctx.lineWidth = 2.5;
          bars.forEach((_, idx) => {
            ctx.beginPath();
            ctx.moveTo(idx * barW, 0);
            ctx.lineTo(idx * barW, barH);
            ctx.stroke();
          });
          // Zebra stripes on high-luminance white bar
          ctx.fillStyle = 'rgba(255, 204, 102, 0.45)';
          for (let y = 0; y < barH; y += 12) {
