    return {
      '@context': 'https://schema.org',
      '@type': 'MediaObject',
      name: `Studio Session - ${activeBridge.label}`,
      dateCreated: new Date().toISOString(),
      encodingFormat: activeBridge.encoder,
      contentUrl: endpointUrl,
      operatingSystemBridge: {
